# AnyDesk Pivot Detector - Example Configuration

# Application Settings
APP_NAME="AnyDesk Pivot Detector"
APP_LOG_LEVEL="info"
APP_REPORT_OUTPUT_DIR="reports"

# AnyDesk Paths (Defaults)
ANYDESK_TRACE_PATH="C:\ProgramData\AnyDesk\ad.trace"
ANYDESK_SYSTEM_CONF_PATH="C:\ProgramData\AnyDesk\system.conf"
ANYDESK_SERVICE_CONF_PATH="C:\ProgramData\AnyDesk\service.conf"

# Monitor Settings
MONITOR_INTERVAL_SECS=5
MONITOR_ALERT_THRESHOLD=60
WORKING_HOUR_START=9
WORKING_HOUR_END=17

# Network Settings
# Allowed AnyDesk IDs (comma separated)
ALLOWED_ANYDESK_IDS="111222333,444555666"

# Reporting
REPORTING_FORMAT="json"
ENABLE_SYSLOG=false
SYSLOG_SERVER="127.0.0.1:514"
